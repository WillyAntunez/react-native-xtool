{
  "env": [
    "RCT_NEW_ARCH_ENABLED"
  ],
  "helpers": [
    "install_modules_dependencies"
  ],
  "names": {
    "reduced": {
      "headerDir": null,
      "moduleName": null,
      "name": ""
    },
    "shim": {
      "headerDir": null,
      "moduleName": null,
      "name": ""
    }
  },
  "reduced": {
    "differs": {
      "compilerFlags": [
        "-Wno-comma",
        "-Wno-shorten-64-to-32"
      ],
      "dependencies": [
        "React-RCTFabric",
        "React-Codegen",
        "RCT-Folly",
        "RCTRequired",
        "RCTTypeSafety",
        "ReactCommon/turbomodule/core"
      ],
      "headerSearchPaths": [
        "$(PODS_ROOT)/boost"
      ],
      "preprocessorDefines": [
        {
          "config": null,
          "name": "RCT_NEW_ARCH_ENABLED",
          "value": "1"
        }
      ],
      "requiresArc": false,
      "warnings": [
        "`install_modules_dependencies(s)` detected — dependency wiring may be incomplete without Ruby.",
        "Env-var or Ruby-config interpolation detected — values may not translate cleanly without Ruby.",
        "Dropped Folly define(s) FOLLY_NO_CONFIG, FOLLY_MOBILE=1, FOLLY_USE_LIBCPP=1 — the prebuilt React Native headers ship folly-config.h, and defining them without the full CocoaPods set breaks the build."
      ]
    }
