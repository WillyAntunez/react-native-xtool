    "preprocessorDefines": [],
    "privateHeaderFiles": [],
    "publicHeaderFiles": [],
    "reader": "ruby",
    "requiresArc": true,
    "resources": [],
    "sourceFiles": [
      "apple/**/*.{h,m,mm,swift}"
    ],
    "spmDependencies": [],
    "subspecDependencies": {},
    "swiftConditions": [],
    "swiftVersions": [],
    "unresolvedSources": [],
    "usesInstallModulesDependencies": true,
    "version": "",
    "warnings": [],
    "weakFrameworks": []
  },
  "tsReaders": {
    "dependencies": {
      "onlyShim": [],
      "onlyTs": []
    },
    "resourceBundles": {
      "onlyShim": [],
      "onlyTs": []
    }
