{
  "name": "react-native-xtool",
  "version": "0.1.0-alpha.2",
  "description": "Build Expo and bare React Native iOS dev builds on Linux via xtool",
  "keywords": [
    "expo",
    "ios",
    "linux",
    "xtool",
    "react-native",
    "swiftpm",
    "cli"
  ],
  "homepage": "https://github.com/WillyAntunez/react-native-xtool",
  "bugs": {
    "url": "https://github.com/WillyAntunez/react-native-xtool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillyAntunez/react-native-xtool.git"
  },
  "license": "MIT",
  "author": "Willy Antunez",
  "type": "module",
  "bin": {
    "rn-xtool": "bin/rn-xtool.js"
  },
  "files": [
    "bin",
    "dist",
    "patches",
    "scripts/rn-spm-generate.js",
    "scripts/package.json",
    "scripts/build-expo-modules-jsi.sh",
    "scripts/stage-frameworks.sh",
    "shims",
    "vendor",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "scan:private": "bash scripts/scan-private.sh"
  },
  "dependencies": {
    "@expo/config": "^58.0.7",
    "@expo/config-plugins": "^58.0.10",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "micromatch": "~4.0.8",
    "patch-package": "^8.0.1",
    "plist": "^5.0.0",
    "signal-exit": "^4.1.0",
    "xcode": "^4.0.0",
    "yargs": "~17.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/plist": "^3.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
