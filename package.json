    "test": "vitest run",
    "lint": "tsc --noEmit",
    "scan:private": "bash scripts/scan-private.sh"
  },
  "dependencies": {
    "@expo/config": "^58.0.7",
    "@expo/config-plugins": "^58.0.10",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "patch-package": "^8.0.1",
    "plist": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/plist": "^3.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
