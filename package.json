{
  "name": "expo-xtool",
  "version": "0.1.0-alpha.1",
  "description": "Build Expo iOS dev builds on Linux via xtool",
  "keywords": [
    "expo",
    "ios",
    "linux",
    "xtool",
    "react-native",
    "swiftpm",
    "cli"
  ],
  "homepage": "https://github.com/WillyAntunez/expo-xtool",
  "bugs": {
    "url": "https://github.com/WillyAntunez/expo-xtool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillyAntunez/expo-xtool.git"
  },
  "license": "MIT",
  "author": "Willy Antunez",
  "type": "module",
  "bin": {
    "expo-xtool": "bin/expo-xtool.js"
  },
  "files": [
    "bin",
    "dist",
    "patches",
    "scripts",
    "shims",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "build": "tsc -p .",
