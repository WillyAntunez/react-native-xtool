#!/usr/bin/env python3
"""Linux stand-in for the subset of macOS `plutil` that React Native's SPM scripts use.

Supported: `plutil -convert json -o - <file>` and `plutil -convert json -o <out> <file>`.
"""
import json
import plistlib
import sys


def main(argv):
    if len(argv) < 4 or argv[0] != "-convert" or argv[1] != "json" or argv[2] != "-o":
        sys.stderr.write("plutil shim: unsupported arguments: %r\n" % (argv,))
        return 2
    out, src = argv[3], argv[4]
    with open(src, "rb") as f:
        data = plistlib.load(f)

    def fix(obj):
        if isinstance(obj, bytes):
            return obj.decode("latin-1")
        if isinstance(obj, dict):
            return {k: fix(v) for k, v in obj.items()}
        if isinstance(obj, list):
            return [fix(v) for v in obj]
        return obj

    text = json.dumps(fix(data))
    if out == "-":
        sys.stdout.write(text)
    else:
        with open(out, "w") as f:
            f.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
