+  const expoDir = path.dirname(
+    createRequire(path.join(appRoot, 'package.json')).resolve('expo/package.json')
+  );
+  const configPlugins = createRequire(path.join(expoDir, 'package.json')).resolve(
+    '@expo/config-plugins'
